.PHONY: help

LEGACY_BACKEND_DIR := $(CURDIR)/backend

help:
	@echo "Legacy targets:"
	@echo "  Old backend root: $(LEGACY_BACKEND_DIR)"
	@echo "  Run API:          cd $(LEGACY_BACKEND_DIR) && go run ./cmd/api"
	@echo "  Run migrate:      cd $(LEGACY_BACKEND_DIR) && go run ./cmd/db_migrate"
	@echo "  Legacy docs:      $(CURDIR)/docs"
	@echo "  Legacy deploy:    $(CURDIR)/deploy"
	@echo "  Legacy make dir:  $(CURDIR)/make"
